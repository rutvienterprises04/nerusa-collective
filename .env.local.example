# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# --- Static UPI payment (Phase 1) ---
NEXT_PUBLIC_UPI_ID=yourshop@upi
NEXT_PUBLIC_UPI_PAYEE_NAME=Your Stationery Shop

# --- Admin panel access (simple shared password, upgrade later) ---
ADMIN_PASSWORD=change-me

# --- Shiprocket (Phase 2 — leave blank until you have an account) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# When credentials above are blank, the app runs Shiprocket in MOCK mode:
# shipments are simulated locally so you can test the full flow end-to-end.
